rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Watch profile avatars (existing app paths)
    match /users/{userId}/watchProfiles/{rest=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Draft videos before Stream encode (author-only)
    match /users/{userId}/works/{workId}/staging/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 32 * 1024 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
    }

    // Promo short custom thumbnail (author-uploaded)
    match /users/{userId}/works/{workId}/{fileName} {
      allow read: if fileName.matches('promo-thumbnail[.].*');
      allow write: if request.auth != null
        && request.auth.uid == userId
        && fileName.matches('promo-thumbnail[.].*')
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Business invite attachment (resume/document, author-uploaded; shared via signed download URL)
    match /users/{userId}/business-invites/{inviteId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 20 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf'
            || request.resource.contentType == 'application/msword'
            || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document');
    }

    // Verified uploader videos — requires custom claim once you set it from webhooks
    match /uploads/{userId}/videos/{rest=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && (request.auth.token.depositVerified == true
            || request.auth.token.uploaderDepositVerified == true);
    }
  }
}

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Watch profile avatars (existing app paths)
    match /users/{userId}/watchProfiles/{rest=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Promo short custom thumbnail (author-uploaded)
    match /users/{userId}/works/{workId}/promo-thumbnail.{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Verified uploader videos — requires custom claim once you set it from webhooks
    match /uploads/{userId}/videos/{rest=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && (request.auth.token.depositVerified == true
            || request.auth.token.uploaderDepositVerified == true);
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'];
    }

    match /config/adminAccess {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /users/{userId}/watchProfiles/{profileId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isAdmin());

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role == 'member';

      allow update: if request.auth != null
        && (
          (request.auth.uid == userId
            && request.resource.data.role == resource.data.role)
          || isAdmin()
        );
    }

    match /billingVerifications/{uid} {
      allow read, write: if false;
    }

    match /paymentEvents/{eventId} {
      allow read, write: if false;
    }

    match /users/{userId}/private/{docId} {
      allow read, write: if false;
    }

    // 풀영상·홍보 쇼츠 — 변경은 서버 API(Admin SDK)만
    match /users/{userId}/works/{workId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }

    match /users/{userId}/works/{workId}/promoShort/{promoId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }

    match /users/{userId}/works/{workId}/prologueShort/{prologueId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }

    // 신고 — 서버 API(Admin SDK)만
    match /reports/{reportId} {
      allow read, write: if false;
    }

    match /adminAuditLog/{logId} {
      allow read, write: if false;
    }

    // 레거시 업로드 경로 (읽기만)
    match /users/{userId}/videos/{videoId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

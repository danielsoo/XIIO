rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'];
    }

    match /config/adminAccess {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /users/{userId}/watchProfiles/{profileId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isAdmin());

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role == 'member';

      allow update: if request.auth != null
        && (
          (request.auth.uid == userId
            && request.resource.data.role == resource.data.role)
          || isAdmin()
        );
    }

    match /billingVerifications/{uid} {
      allow read, write: if false;
    }

    match /paymentEvents/{eventId} {
      allow read, write: if false;
    }

    match /users/{userId}/private/{docId} {
      allow read, write: if false;
    }

    match /users/{userId}/videos/{videoId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && (request.auth.token.depositVerified == true
            || request.auth.token.uploaderDepositVerified == true);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
